# Firebase-Konfiguration
# Erstelle ein Firebase-Projekt unter https://console.firebase.google.com/
# Aktiviere Firestore und Storage, dann kopiere die Konfigurationsdaten hierher

VITE_FIREBASE_API_KEY=dein-api-key
VITE_FIREBASE_AUTH_DOMAIN=dein-projekt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dein-projekt-id
VITE_FIREBASE_STORAGE_BUCKET=dein-projekt.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Claude API Key (Anthropic)
# Erstelle einen API-Key unter https://console.anthropic.com/
# HINWEIS: Der API-Key wird im Browser sichtbar sein (nur fuer persoenliche Nutzung geeignet)
VITE_ANTHROPIC_API_KEY=sk-ant-...
